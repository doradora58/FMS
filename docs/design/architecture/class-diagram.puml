@startuml FMS_Current_Class_Diagram
title FMS - Implemented Source Class Diagram
left to right direction
skinparam classAttributeIconSize 0

package "FMS.Controllers" {
  class TransportJobController {
    +Create(req): Task<IActionResult>
    +GetAll(): Task<ActionResult<IEnumerable<Job>>>
    +GetById(jobId): Task<IActionResult>
  }
}

package "FMS.Facade" {
  interface ITransportJobFacade {
    +CreateTransportJobAsync(req): Task<CreateTransportJobCommand>
    +GetAllJobsAsync(): Task<IEnumerable<IJob>>
    +GetJobAsync(jobId): Task<IJob?>
    +ProgressJobAsync(jobId, trigger): Task
  }
  class TransportJobFacade {
    +CreateTransportJobAsync(req): Task<CreateTransportJobCommand>
    +GetAllJobsAsync(): Task<IEnumerable<IJob>>
    +GetJobAsync(jobId): Task<IJob?>
    +ProgressJobAsync(jobId, trigger): Task
  }
}

package "FMS.JobManagement.Commands" {
  interface ICommand<TResult>
  interface ICommandHandler<TCommand, TResult> {
    +HandleAsync(command, cancellationToken): Task<TResult>
  }
  interface ICommandExecutor {
    +EnqueueAsync(command, cancellationToken): Task
    +ExecuteAsync(command, cancellationToken): Task<TResult>
  }
  class CommandExecutor
  class CreateTransportJobCommand
  class JobActivity <<ActivitySource>>
  class TransitionJobStatusCommand
  interface ICommandQueue<TCommand>
  interface ICommandValidator<TCommand>
  class CreateTransportJobCommandValidator
  class CommandValidationException
  class Unit
}

package "FMS.JobManagement.Handlers" {
  class CreateTransportJobCommandHandler
  class TransitionJobStatusCommandHandler
}

package "FMS.JobManagement.Services" {
  interface IJobQueries
  class JobQueries {
    +GetAllJobsAsync(): Task<IEnumerable<IJob>>
    +GetJobAsync(jobId): Task<IJob?>
  }
}

package "FMS.JobManagement.StateMachine" {
  class JobStateMachine {
    +CurrentState: JobStatus
    +Fire(trigger): void
    +CanFire(trigger): bool
  }
}

package "FMS.JobManagement.Models" {
  class Job
  enum JobStatus {
    Routing
    Queued
    Assigned
    InTransit
    Completed
    Failed
    Cancelled
  }
  enum JobTrigger {
    AssignAgv
    StartMoving
    Complete
    Fail
    Cancel
  }
}

package "FMS.Core" {
  interface IJob {
    +JobId: string
    +SourceOrderId: string
    +Status: string
    +RoutePolyline: string?
    +OriginLatitude: double?
    +OriginLongitude: double?
    +DestinationLatitude: double?
    +DestinationLongitude: double?
  }
  interface ITransportJobRepository {
    +AddAsync(job): Task
    +GetAsync(jobId): Task<IJob?>
    +GetAllAsync(): Task<IEnumerable<IJob>>
    +UpdateAsync(job): Task
  }
  interface IMessagePublisher {
    +PublishJobStatusAsync(jobEvent): Task
  }
  interface IRoutingService
  interface IJobFactory {
    +CreatePendingRoute(jobId, orderId, fromAddress, toAddress): IJob
    +Create(orderId, fromAddress, toAddress, distance, duration): IJob
  }
  class TransportJobRequest
  class RouteInfo {
    +DistanceMeters: double
    +DurationSeconds: int
    +EncodedPolyline: string?
  }
  class JobStatusEvent
  class JobFactory
}

package "FMS.Infrastructure" {
  class InMemoryJobCreationQueue <<BackgroundService>>
  class MongoTransportJobRepository
  class JobDocument
  class RabbitMqPublisher
  class GoogleMapsRoutingService
  class MockTransportJobRepository
  class MockMessagePublisher
  class MockRoutingService
}

TransportJobController --> ITransportJobFacade
TransportJobController --> ICommandExecutor : enqueue after response completion
TransportJobFacade ..|> ITransportJobFacade
TransportJobFacade --> ICommandExecutor
TransportJobFacade --> IJobQueries
TransportJobFacade --> ICommandValidator : validate create command
TransportJobFacade ..> TransportJobRequest

CommandExecutor ..|> ICommandExecutor
CommandExecutor --> ICommandHandler : resolve and execute
CommandExecutor --> ICommandQueue : enqueue command
CreateTransportJobCommandValidator ..|> ICommandValidator
CreateTransportJobCommandValidator ..> CreateTransportJobCommand
InMemoryJobCreationQueue ..> JobActivity : restore trace context
CreateTransportJobCommandHandler ..|> ICommandHandler
CreateTransportJobCommandHandler ..> JobActivity : create job spans
CreateTransportJobCommandHandler --> ITransportJobRepository
CreateTransportJobCommandHandler --> IJobFactory
CreateTransportJobCommandHandler --> IRoutingService
CreateTransportJobCommandHandler --> IMessagePublisher
CreateTransportJobCommandHandler ..> JobStatusEvent
TransitionJobStatusCommandHandler ..|> ICommandHandler
TransitionJobStatusCommandHandler ..> JobActivity : create transition spans
TransitionJobStatusCommandHandler --> ITransportJobRepository
TransitionJobStatusCommandHandler --> IMessagePublisher
TransitionJobStatusCommandHandler --> JobStateMachine
TransitionJobStatusCommandHandler ..> JobStatusEvent
JobQueries ..|> IJobQueries
JobQueries --> ITransportJobRepository

JobStateMachine --> JobStatus
JobStateMachine --> JobTrigger
JobFactory ..|> IJobFactory
JobFactory ..> Job
Job ..|> IJob
JobDocument ..|> IJob
JobDocument ..> Job : ToDomain / FromDomain

MongoTransportJobRepository ..|> ITransportJobRepository
MongoTransportJobRepository --> JobDocument
RabbitMqPublisher ..|> IMessagePublisher
RabbitMqPublisher ..> Activity : inject traceparent / tracestate
GoogleMapsRoutingService ..|> IRoutingService
GoogleMapsRoutingService ..> RouteInfo : returns route geometry

MockTransportJobRepository ..|> ITransportJobRepository
MockMessagePublisher ..|> IMessagePublisher
MockRoutingService ..|> IRoutingService
InMemoryJobCreationQueue ..|> ICommandQueue
InMemoryJobCreationQueue --> ICommandExecutor : execute queued command

note bottom of InMemoryJobCreationQueue
  Process-local, non-durable queue.
  RabbitMQ is used only by the external event publisher.
end note
@enduml
