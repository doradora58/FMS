@startuml FMS_Create_Transport_Job
title Create Transport Job Asynchronously

actor "API Client" as Client
participant "TransportJobController" as Controller
participant "TransportJobFacade" as Facade
participant "CreateTransportJobCommandValidator" as Validator
participant "CommandExecutor" as Executor
participant "InMemoryJobCreationQueue\n(BackgroundService)" as CommandQueue

Client -> Controller : POST /api/transportjob/create\nTransportJobRequest
Controller -> Facade : CreateTransportJobAsync(request)
Facade -> Facade : Create command with new JobId
Facade -> Validator : Validate(command)
alt Validation fails
  Validator --> Facade : field errors
  Facade --> Controller : CommandValidationException
  Controller --> Client : 400 Bad Request\nValidationProblemDetails
else Validation succeeds
  Validator --> Facade : no errors
  Facade --> Controller : validated command
  Controller -> Controller : Register Response.OnCompleted callback
  Controller --> Client : 202 Accepted\n{ jobId, orderId, status = Accepted }
  == After response is sent ==
  Controller -> Executor : EnqueueAsync(command)
  Executor -> CommandQueue : EnqueueAsync(command)
  CommandQueue --> Executor : queued in process memory
  Executor --> Controller : accepted for background execution
end

== Background command execution ==

participant "CommandExecutor" as WorkerExecutor
participant "CreateTransportJobCommandHandler" as Handler
participant "JobFactory" as Factory
participant "ITransportJobRepository\n(MongoDB or mock)" as Repository
database "MongoDB\nFmsDb.Jobs" as Mongo
participant "IRoutingService" as Routing
participant "IMessagePublisher\n(RabbitMQ or mock)" as StatusPublisher
queue "RabbitMQ\njob-status-queue" as StatusQueue

CommandQueue -> WorkerExecutor : Dequeue command
WorkerExecutor -> Handler : Execute(CreateTransportJobCommand)
Handler -> Repository : GetAsync(jobId)\n(check duplicate delivery)
Repository --> Handler : existing job or null
alt Existing job already processed
  Handler --> WorkerExecutor : no-op
else New job or existing Routing job
  opt First delivery
    Handler -> Factory : CreatePendingRoute(jobId, orderId, addresses)
    Factory --> Handler : Job(status = Routing)
    Handler -> Repository : AddAsync(job)
    Repository -> Mongo : Insert JobDocument\n(after response completion)
    Mongo --> Repository : insert result
  end
  Handler -> Routing : GetRouteAsync(addresses)
  alt Route succeeds
    Routing --> Handler : RouteInfo
    Handler -> Repository : Update route, status = Queued
  else Route calculation fails
    Routing --> Handler : error
    Handler -> Repository : Update status = Failed
  end
  Handler -> StatusPublisher : PublishJobStatusAsync(new status)
  StatusPublisher -> StatusQueue : Publish external JobStatusEvent
  StatusQueue --> StatusPublisher : publish call completes
  StatusPublisher --> Handler : complete
end
Handler --> WorkerExecutor : complete

note over Controller,CommandQueue
  Command execution starts only from the response-completed callback.
  The command queue is in memory, not RabbitMQ or durable storage.
  A process failure after 202 can lose a queued or not-yet-enqueued command.
end note
@enduml
