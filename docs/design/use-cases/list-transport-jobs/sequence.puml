@startuml FMS_List_Transport_Jobs
title List Transport Jobs

actor "API Client" as Client
participant "TransportJobController" as Controller
participant "TransportJobFacade" as Facade
participant "JobQueries" as Queries
participant "ITransportJobRepository\n(MongoDB or mock)" as Repository
database "MongoDB\nFmsDb.Jobs" as Mongo

Client -> Controller : GET /api/transportjob
Controller -> Facade : GetAllJobsAsync()
Facade -> Queries : GetAllJobsAsync()
Queries -> Repository : GetAllAsync()
alt Production
  Repository -> Mongo : Find all Jobs
  Mongo --> Repository : JobDocuments
else Development
  Repository -> Repository : Read in-memory jobs
end
Repository --> Queries : jobs
Queries --> Facade : jobs
Facade --> Controller : jobs
Controller --> Client : 200 OK with jobs
@enduml
