@startuml FMS_Transition_Job_Status
title Transition Job Status

actor "Application Caller" as Caller
participant "TransportJobFacade" as Facade
participant "CommandExecutor" as Executor
participant "TransitionJobStatusCommandHandler" as Handler
participant "ITransportJobRepository\n(MongoDB or mock)" as Repository
participant "JobStateMachine" as StateMachine
participant "IMessagePublisher\n(RabbitMQ or mock)" as Publisher
database "MongoDB\nFmsDb.Jobs" as Mongo
queue "RabbitMQ\njob-status-queue" as Rabbit

note over Caller,Facade
  ProgressJobAsync exists on the facade,
  but is not exposed by a controller HTTP route.
end note

Caller -> Facade : ProgressJobAsync(jobId, trigger)
Facade -> Executor : ExecuteAsync(TransitionJobStatusCommand)
Executor -> Handler : HandleAsync(command)
Handler -> Repository : GetAsync(jobId)
alt Job not found
  Repository --> Handler : null
  Handler --> Executor : KeyNotFoundException
  Executor --> Facade : error
  Facade --> Caller : error
else Job found
  Repository --> Handler : job(current status)
  Handler -> StateMachine : Create(current status)
  Handler -> StateMachine : Fire(trigger)
  alt Trigger not permitted
    StateMachine --> Handler : InvalidOperationException
    Handler --> Executor : error
    Executor --> Facade : error
    Facade --> Caller : error
  else Trigger permitted
    StateMachine --> Handler : new status
    Handler -> Repository : UpdateAsync(job)
    alt Production
      Repository -> Mongo : Replace JobDocument
      Mongo --> Repository : update result
    else Development
      Repository -> Repository : Update in-memory job
    end
    Repository --> Handler : complete
    Handler -> Publisher : PublishJobStatusAsync(new status)
    alt Production
      Publisher -> Rabbit : Publish JobStatusEvent
      Rabbit --> Publisher : publish call completes
    else Development
      Publisher -> Publisher : Log mock event
    end
    Publisher --> Handler : complete
    Handler --> Executor : complete
    Executor --> Facade : complete
    Facade --> Caller : complete
  end
end
@enduml
