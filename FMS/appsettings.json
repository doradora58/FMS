{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UseMocks": true,
  "RabbitMQ": {
    "HostName": "rabbitmq"
  },
  "Vda5050": {
    "TopicRoot": "uagv/v2",
    "Broker": {
      "Host": "rabbitmq",
      "Port": 1883,
      "UseTls": false
    }
  },
  "MongoDB": {
    "ConnectionString": "mongodb://..."
  },
  "GoogleMaps": {
    "ApiKey": "YOUR_GOOGLE_MAPS_API_KEY"
  }
}
