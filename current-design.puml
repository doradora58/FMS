@startuml FMS_Component_Architecture
title FMS - Current Component Architecture
left to right direction
skinparam componentStyle rectangle

actor "API Client" as Client

package "FMS (ASP.NET Core)" {
  component "TransportJobController\nREST API" as Controller
  component "TransportJobFacade" as Facade
  component "Program.cs\nDI / Middleware / Telemetry" as Host
  interface "ITransportJobFacade" as IFacade
}

package "FMS.JobManagement" {
  component "CommandExecutor\n(enqueue / execute)" as CommandExecutor
  component "CreateTransportJobCommandValidator" as Validator
  component "CreateTransportJobCommandHandler" as CreateJobHandler
  component "TransitionJobStatusCommandHandler" as TransitionHandler
  component "JobQueries" as JobQueries
  component "JobStateMachine" as StateMachine
  interface "ICommandExecutor" as ICommandExecutor
  interface "ICommandQueue<CreateTransportJobCommand>" as ICommandQueue
  interface "IJobQueries" as IJobQueries
}

package "FMS.Core (Contracts / Models)" {
  component "JobFactory" as JobFactory
  interface "IJobFactory" as IJobFactory
  interface "ITransportJobRepository" as IJobRepository
  interface "IRoutingService" as IRouting
  interface "IMessagePublisher" as IMessagePublisher
  component "IJob / TransportJobRequest /\nRouteInfo / JobStatusEvent" as CoreModels
}

package "FMS.Infrastructure" {
  component "InMemoryJobCreationQueue\n(BackgroundService)" as CommandQueue
  component "MongoTransportJobRepository" as MongoRepository
  component "GoogleMapsRoutingService" as GoogleMaps
  component "RabbitMqPublisher\n(external status events only)" as RabbitPublisher
  component "Development mocks\n(repository / routing / publisher)" as Mocks
}

database "MongoDB\nFmsDb.Jobs" as Mongo
cloud "Google Routes API" as RoutesApi
queue "RabbitMQ\njob-status-queue" as Rabbit

Client --> Controller : HTTP
Controller --> IFacade
Controller --> ICommandExecutor : enqueue after response completed
Facade ..|> IFacade
Facade --> Validator
Facade --> IJobQueries : read queries
CommandExecutor ..|> ICommandExecutor
CommandExecutor --> ICommandQueue : enqueue / execute
CommandQueue ..|> ICommandQueue
CommandQueue --> ICommandExecutor : background execution
CreateJobHandler --> IJobRepository : insert / update
CreateJobHandler --> IJobFactory
CreateJobHandler --> IRouting : calculate route
CreateJobHandler --> IMessagePublisher : publish final status
TransitionHandler --> IJobRepository
TransitionHandler --> IMessagePublisher : publish status
TransitionHandler --> StateMachine : validate transition
JobQueries ..|> IJobQueries
JobQueries --> IJobRepository
JobFactory ..|> IJobFactory

MongoRepository ..|> IJobRepository
GoogleMaps ..|> IRouting
RabbitPublisher ..|> IMessagePublisher
Mocks ..|> IJobRepository
Mocks ..|> IRouting
Mocks ..|> IMessagePublisher

MongoRepository --> Mongo : persist / read jobs
GoogleMaps --> RoutesApi : compute route
RabbitPublisher --> Rabbit : publish external status event

Host ..> CommandExecutor : register
Host ..> Validator : register
Host ..> CreateJobHandler : register
Host ..> TransitionHandler : register
Host ..> JobQueries : register
Host ..> Facade : register
Host ..> MongoRepository : production registration
Host ..> GoogleMaps : production registration
Host ..> RabbitPublisher : production registration
Host ..> Mocks : Development registration

note bottom of CommandQueue
  Process-local and non-durable.
  RabbitMQ is not used for command execution.
end note
@enduml

@startuml FMS_Create_Job_Sequence
title FMS - Create Transport Job

actor "API Client" as Client
participant "TransportJobController" as Controller
participant "TransportJobFacade" as Facade
participant "CreateTransportJobCommandValidator" as Validator
participant "CommandExecutor" as Executor
participant "InMemoryJobCreationQueue" as CommandQueue

Client -> Controller : POST /api/transportjob/create\n{ orderId, fromAddress, toAddress }
Controller -> Facade : CreateTransportJobAsync(request)
Facade -> Facade : Create command with new JobId
Facade -> Validator : Validate(command)
alt validation fails
  Validator --> Facade : field errors
  Facade --> Controller : validation error
  Controller --> Client : 400 Bad Request
else validation succeeds
  Validator --> Facade : no errors
  Facade --> Controller : validated command
  Controller -> Controller : Register Response.OnCompleted callback
  Controller --> Client : 202 Accepted { jobId, status = Accepted }
  == after response completion ==
  Controller -> Executor : EnqueueAsync(command)
  Executor -> CommandQueue : enqueue in process memory
  CommandQueue --> Executor : queued
end

== Background command execution ==

participant "CommandExecutor" as WorkerExecutor
participant "CreateTransportJobCommandHandler" as Handler
participant "IJobFactory\n(JobFactory)" as Factory
participant "ITransportJobRepository\n(Mongo or mock)" as Repository
database "MongoDB" as Mongo
participant "IRoutingService" as Routing
participant "IMessagePublisher" as Publisher
queue "RabbitMQ\njob-status-queue" as StatusQueue

CommandQueue -> WorkerExecutor : dequeue command
WorkerExecutor -> Handler : Execute(CreateTransportJobCommand)
Handler -> Repository : GetAsync(jobId)
Repository --> Handler : existing job or null
opt first delivery
  Handler -> Factory : CreatePendingRoute(jobId, orderId, addresses)
  Factory --> Handler : Job(status = Routing)
  Handler -> Repository : AddAsync(job)
  Repository -> Mongo : insert JobDocument\nafter response completion
  Mongo --> Repository : insert result
end
Handler -> Routing : GetRouteAsync(addresses)
alt route calculated
  Routing --> Handler : RouteInfo
  Handler -> Repository : update route and set Queued
else route failure
  Routing --> Handler : error
  Handler -> Repository : set Failed
end
Handler -> Publisher : PublishJobStatusAsync(status)
Publisher -> StatusQueue : external JobStatusEvent
StatusQueue --> Publisher : publish call completes
Publisher --> Handler : complete
Handler --> WorkerExecutor : complete

note over Controller,CommandQueue
  The response-completed callback enqueues the command.
  A process failure after 202 can lose accepted work.
end note
@enduml

@startuml FMS_Job_State_Machine
title FMS - Job Status Transitions

[*] --> Routing
Routing --> Queued : route calculated
Routing --> Failed : route failed
Queued --> Assigned : AssignAgv
Queued --> Cancelled : Cancel
Assigned --> InTransit : StartMoving
Assigned --> Cancelled : Cancel
InTransit --> Completed : Complete
InTransit --> Failed : Fail
Completed --> [*]
Failed --> [*]
Cancelled --> [*]

note right of InTransit
  Unsupported triggers cause
  InvalidOperationException.
end note
note bottom of Queued
  Job creation and successful status
  transitions publish a status event
  after persistence.
end note
@enduml
